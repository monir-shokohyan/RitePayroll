
echo "Running pre-commit checks..."
npm run format

# Run format:check (fails if code is not formatted)
npm run format:check || {
  echo "❌ Format check failed. Run 'npm run format' to fix."
  exit 1
}

# Run build to catch TypeScript errors
npm run build || {
  echo "❌ Build failed."
  exit 1
}

echo "✅ All pre-commit checks passed!"